    <name>appservice-infrastructure-platform</name>
    <description>Platform Infrastructure Engines: Audit Logger, SMS Gateway, Quartz Scheduler, Mail Engine, MCP Plane</description>

    <dependencies>
        <dependency>
            <groupId>ir.bahmanheydarinejad</groupId>
            <artifactId>appservice-core-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>ir.bahmanheydarinejad</groupId>
            <artifactId>appservice-common</artifactId>
        </dependency>

