# Code-Graph-RAG Configuration Template
# Copy to .env.cgr or configure your system environment variables.
# NEVER commit secret keys or production credentials.

# Graph Backend Selection
# Default: Embedded serverless SQLite (recommended for local development, zero-docker)
# CGR_GRAPH_BACKEND=sqlite
# CGR_SQLITE_PATH=~/.cgr/graph.sqlite

# Optional Shared Docker Stack (Memgraph + Qdrant)
# CGR_GRAPH_BACKEND=memgraph
# MEMGRAPH_HOST=localhost
# MEMGRAPH_PORT=7687
# QDRANT_HOST=localhost
# QDRANT_PORT=6333

# Embeddings & Sync Optimizations
# Set to 1 to skip semantic embeddings when fast structural graph sync is preferred
CGR_SKIP_EMBEDDINGS=1

# Language Frontends
JAVA_FRONTEND=heuristic
PYTHON_FRONTEND=heuristic

# Optional LLM Orchestrator for Natural Language Conversational Queries (cgr start -a "query")
# Supported providers: openai, anthropic, google, ollama
# ORCHESTRATOR_PROVIDER=google
# ORCHESTRATOR_MODEL=gemini-1.5-pro
# GEMINI_API_KEY=your_gemini_api_key_here

# CYPHER_PROVIDER=google
# CYPHER_MODEL=gemini-1.5-pro
